{
  "name": "clinic-tracker-server-controller",
  "version": "1.2.0",
  "description": "Clinic Tracker Server Controller - desktop app that manages the backend server, database config, and system tray",
  "author": "Clinic Tracker",
  "private": true,
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win nsis"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.clinictracker.server-controller",
    "productName": "Clinic Tracker - Server Controller",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!node_modules/.cache/**",
          "!node_modules/.package-lock.json",
          "!node_modules/**/test/**",
          "!node_modules/**/tests/**",
          "!node_modules/**/*.md",
          "!node_modules/**/.npmignore",
          "!node_modules/**/LICENSE*",
          "!node_modules/**/CHANGELOG*"
        ]
      },
      {
        "from": "../dist",
        "to": "dist",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clinic Tracker Server"
    }
  }
}
