{
  "name": "clinic-tracker-app",
  "version": "1.1.0",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "server:test": "cross-env PORT=3100 NODE_ENV=test SERVE_FRONTEND=1 DB_PATH=./server/database/e2e_test.db node server/index.js",
    "controller:dev": "cd controller && npm start",
    "test:all": "npm run build && npm run controller:dev",
    "start": "npm run build && node server/index.js",
    "start:prod": "npm run build && cross-env SERVE_FRONTEND=1 node server/index.js",
    "test": "jest server/tests/",
    "test:unit": "jest server/tests/ --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:report": "npx playwright show-report",
    "test:e2e:update-snapshots": "npx playwright test --update-snapshots"
  },
  "dependencies": {
    "7zip-min": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "date-fns": "^3.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.344.0",
    "mssql": "^10.0.4",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "pdf-parse": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "sql.js": "^1.10.2",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.35",
    "selenium-webdriver": "^4.43.0",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.0"
  }
}
