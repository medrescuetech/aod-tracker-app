# AOD Tracker Environment Configuration
# Copy this file to .env and update values for your deployment

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Frontend Serving
SERVE_FRONTEND=1
DIST_PATH=./dist

# Database Configuration (SQLite)
DB_PATH=./database/app.db
DB_TYPE=sqlite

# Security (CRITICAL: Change these in production!)
# Generate a strong JWT secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin password (required for production, optional for development)
# Generate a strong password and set this before first run in production
ADMIN_PASSWORD=change-this-to-strong-password

# Optional: MSSQL Database Configuration (uncomment to use SQL Server)
# DB_TYPE=mssql
# DB_HOST=localhost
# DB_PORT=1433
# DB_NAME=AODTracker
# DB_USER=sa
# DB_PASSWORD=your-db-password
# DB_ENCRYPT=false
# DB_TRUST_CERT=true

# Optional: Session Configuration
# SESSION_TIMEOUT=86400000

# Optional: File Upload Limits (in bytes)
# MAX_FILE_SIZE=10485760
# UPLOAD_DIR=./uploads

# Optional: Logging
# LOG_LEVEL=info
# LOG_DIR=./logs
